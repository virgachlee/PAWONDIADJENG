---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { homeContent } from "../config/home";
import { siteConfig } from "../config/site";
import chefImage from "../assets/simbok2.JPG";
import conceptImage from "../assets/simbokk.jpg";
import detailImage from "../assets/nuansa2.JPG";
import heroImage from "../assets/wayang.JPG";
import interiorImage from "../assets/nuansa9.JPG";
import wineImage from "../assets/wine.webp";
import menuBgImage from "../assets/nuansa1.JPG";


const siteUrl = Astro.site ?? new URL("http://localhost:4321");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: siteConfig.name,
  description: siteConfig.description,
  url: new URL(Astro.url.pathname, siteUrl).href,
  image: new URL(siteConfig.defaultImage, siteUrl).href,
  telephone: siteConfig.phone,
  email: siteConfig.email,
  servesCuisine: siteConfig.restaurant.cuisine,
  priceRange: siteConfig.restaurant.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.locality,
    postalCode: siteConfig.address.postalCode,
    addressCountry: siteConfig.address.country,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: siteConfig.hours.schema.dayOfWeek,
      opens: siteConfig.hours.schema.opens,
      closes: siteConfig.hours.schema.closes,
    },
  ],
};
---

<BaseLayout image={siteConfig.defaultImage} structuredData={structuredData}>
  <Nav />

  <main id="main">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <Image
        class="media-fill"
        src={heroImage}
        alt="Chef hands finishing a small ceramic plate beside a live wood fire"
        width={1024}
        height={1536}
        quality={92}
        loading="eager"
        decoding="sync"
      />
      <div class="overlay" style="background: var(--grad-vignette);"></div>
      <div class="overlay" style="background: var(--grad-veil);"></div>
      <div class="hero-content">
        <div class="hero-grid">
          <div class="hero-heading">
            <p class="label-eyebrow reveal">{homeContent.hero.eyebrow}</p>
            <h1 id="hero-title" class="hero-title display reveal reveal-delay-1">
              {homeContent.hero.title[0]}<br />
              <span class="display-italic" style="color: var(--ember);">{homeContent.hero.title[1]}</span><br />
              {homeContent.hero.title[2]}
            </h1>
          </div>

          <div class="hero-copy reveal reveal-delay-2">
            <p>{homeContent.hero.body}</p>
            <div class="hero-actions">
              <a class="button-link" href="#Menu Pawon Diadjeng">{homeContent.hero.action} <span aria-hidden="true">-&gt;</span></a>
            </div>
          </div>
        </div>
      </div>

    </section>

    <section class="marquee" aria-label="Pawon Diadjeng">
      <div class="marquee-track">
        {[...homeContent.marquee, ...homeContent.marquee].map((item) => (
          <span>
            {item}
            <b aria-hidden="true">*</b>
          </span>
        ))}
      </div>
    </section>

    <section id="Tentang Kami" class="section tentangkami-section">
      <div class="container section-grid">
        <div class="section-kicker">
          <p class="label-eyebrow reveal">{homeContent.tentangkami.eyebrow}</p>
        </div>
        <h2 class="section-heading display reveal">
          {homeContent.tentangkami.heading[0]}<br />
          <span class="display-italic" style="color: var(--ember);">Tamuju ati,</span> <br />
          {homeContent.tentangkami.heading[2]}
        </h2>

        <div class="text-block reveal reveal-delay-1">
          {homeContent.tentangkami.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <figure class="figure-detail reveal">
          <div class="image-frame aspect-3-4">
            <Image
              src={detailImage}
              alt="Handmade ceramic bowl with a small seasonal tasting course"
              width={1200}
              height={1500}
              loading="lazy"
            />
          </div>
          <figcaption class="label-eyebrow" style="margin-top: 1rem;">{homeContent.tentangkami.caption}</figcaption>
        </figure>

        <div class="fire-block reveal">
          <div class="fire-media image-frame aspect-16-10">
            <Image
              src={conceptImage}
              alt="Glowing embers and flame in a working restaurant hearth"
              width={1400}
              height={875}
              loading="lazy"
            />
          </div>
          <div class="quote-block">
            <blockquote>"{homeContent.tentangkami.quote}"</blockquote>
            <p class="label-eyebrow" style="margin-top: 1.5rem;">- {homeContent.tentangkami.quoteByline}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="Menu Pawon Diadjeng" class="section surface-section menu-section">
      <div class="menu-section-bg" aria-hidden="true">
        <Image src={menuBgImage} alt="" width={1800} height={1200} loading="lazy" />
      </div>
      <div class="container section-grid">
        <div class="section-kicker">
          <p class="label-eyebrow reveal">{homeContent.menu.eyebrow}</p>
        </div>
        <h2 class="section-heading display reveal">
          {homeContent.menu.heading[0]}<br />
          <span class="display-italic" style="color: var(--ember);">{homeContent.menu.heading[1]}</span><br />
          {homeContent.menu.heading[2]}
        </h2>

        <p class="menu-intro reveal reveal-delay-1">{homeContent.menu.note}</p>

        <div class="menu-filter reveal reveal-delay-2" role="tablist" aria-label="Kategori menu">
          {homeContent.menu.categories.map((category, index) => (
            <button
              type="button"
              class={`menu-filter-btn ${index === 0 ? "is-active" : ""}`}
              data-menu-filter={category}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
            >
              {category}
            </button>
          ))}
        </div>

        <p class="menu-empty" data-menu-empty hidden>Menu kanggo kategori niki dèrèng wonten.</p>

        <div class="menu-gallery reveal reveal-delay-3" data-menu-gallery>
          {homeContent.menu.items.map((item) => (
            <button
              type="button"
              class="menu-thumb"
              data-menu-trigger
              data-name={item.name}
              data-price={item.price}
              data-category={item.category}
              data-desc={item.description}
              data-image={item.image}
              aria-haspopup="dialog"
            >
              <span class="menu-thumb-frame">
                <img src={item.image} alt={item.name} width="300" height="300" loading="lazy" />
              </span>
              <span class="menu-thumb-caption">
                <span class="menu-thumb-name">{item.name}</span>
                <span class="menu-thumb-price">{item.price}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <dialog id="menu-dialog" class="menu-dialog" aria-labelledby="menu-dialog-name">
        <form method="dialog" class="menu-dialog-close-form">
          <button type="submit" class="menu-dialog-close" aria-label="Tutup">&times;</button>
        </form>
        <div class="menu-dialog-media">
          <img id="menu-dialog-image" src="" alt="" />
        </div>
        <div class="menu-dialog-body">
          <p id="menu-dialog-category" class="label-eyebrow"></p>
          <h3 id="menu-dialog-name" class="display"></h3>
          <p id="menu-dialog-price" class="menu-dialog-price"></p>
          <p id="menu-dialog-desc"></p>
        </div>
      </dialog>
    </section>

    <script>
      const menuDialog = document.getElementById("menu-dialog");
      const dialogImage = document.getElementById("menu-dialog-image");
      const dialogCategory = document.getElementById("menu-dialog-category");
      const dialogName = document.getElementById("menu-dialog-name");
      const dialogPrice = document.getElementById("menu-dialog-price");
      const dialogDesc = document.getElementById("menu-dialog-desc");

      document.querySelectorAll("[data-menu-trigger]").forEach((button) => {
        button.addEventListener("click", () => {
          if (!(menuDialog instanceof HTMLDialogElement)) return;
          const { name, price, category, desc, image } = button.dataset;

          if (dialogImage instanceof HTMLImageElement) {
            dialogImage.src = image ?? "";
            dialogImage.alt = name ?? "";
          }
          if (dialogCategory) dialogCategory.textContent = category ?? "";
          if (dialogName) dialogName.textContent = name ?? "";
          if (dialogPrice) dialogPrice.textContent = price ?? "";
          if (dialogDesc) dialogDesc.textContent = desc ?? "";

          menuDialog.showModal();
        });
      });

      if (menuDialog instanceof HTMLDialogElement) {
        menuDialog.addEventListener("click", (event) => {
          if (event.target === menuDialog) {
            menuDialog.close();
          }
        });
      }

      const menuGallery = document.querySelector("[data-menu-gallery]");
      const menuEmptyState = document.querySelector("[data-menu-empty]");
      const filterButtons = document.querySelectorAll("[data-menu-filter]");
      const menuThumbs = document.querySelectorAll(".menu-thumb");

      function applyMenuFilter(category) {
        let visibleCount = 0;

        menuThumbs.forEach((thumb) => {
          const matches = thumb.dataset.category === category;
          thumb.classList.toggle("is-filtered-out", !matches);
          if (matches) visibleCount += 1;
        });

        if (menuEmptyState) {
          menuEmptyState.hidden = visibleCount !== 0;
        }
        if (menuGallery) {
          menuGallery.classList.toggle("is-empty", visibleCount === 0);
        }
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterButtons.forEach((b) => {
            b.classList.toggle("is-active", b === btn);
            b.setAttribute("aria-selected", b === btn ? "true" : "false");
          });

          applyMenuFilter(btn.dataset.menuFilter);
        });
      });

      if (filterButtons.length > 0) {
        applyMenuFilter(filterButtons[0].dataset.menuFilter);
      }
    </script>

    <section id="chef" class="section">
      <div class="container section-grid">
        <div class="section-kicker">
          <p class="label-eyebrow reveal">{homeContent.chef.eyebrow}</p>
        </div>
        <h2 class="section-heading display reveal">
          {homeContent.chef.heading.line1}<br />
          <span class="display-italic" style="color: var(--ember);">{homeContent.chef.heading.accent}</span> {homeContent.chef.heading.rest}
        </h2>

        <div class="chef-media image-frame aspect-4-5 reveal">
          <Image
            src={chefImage}
            alt="Black and white candid portrait of Chef Elia Marchetti in profile"
            width={1200}
            height={1500}
            loading="lazy"
          />
        </div>

        <div class="chef-bio reveal reveal-delay-1">
          <p class="chef-quote">
            "{homeContent.chef.quote}"
          </p>
          <div class="hairline" style="margin-block: 2.5rem;"></div>
          <ul class="timeline">
            {homeContent.chef.timeline.map((row) => (
              <li>
                <time datetime={row.year}>{row.year}</time>
                <p class="timeline-quote">"{row.quote}"</p>
                {row.text && <p class="timeline-text">{row.text}</p>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="interior" class="surface-section nuansa-section">
      <div class="interior-hero">
        <Image
          src={interiorImage}
          alt="Twelve-seat tasting counter with terracotta plaster walls, oak beams, candles, and an open hearth"
          width={1800}
          height={1200}
          loading="lazy"
        />
        <div class="overlay" style="background: var(--grad-veil);"></div>
        <div class="interior-caption">
          <p class="label-eyebrow">{homeContent.interior.eyebrow}</p>
          <h2 class="display">
            {homeContent.interior.heading.lead} <span class="display-italic" style="color: var(--ember);">{homeContent.interior.heading.accent}</span>
            {homeContent.interior.heading.rest}
          </h2>
        </div>
      </div>

      <div class="container section">
        <div class="feature-grid nuansa-grid">
          {homeContent.interior.features.map((feature, index) => (
            <section class="nuansa-feature">
              <span class="nuansa-feature-index">{String(index + 1).padStart(2, "0")}</span>
              <p class="label-eyebrow">{feature.title}</p>
              <p>{feature.body}</p>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section id="reserve" class="section reservation">
      <Image
        class="reservation-bg"
        src={wineImage}
        alt=""
        width={900}
        height={1200}
        loading="lazy"
        aria-hidden="true"
      />
      <div class="overlay" style="background: var(--grad-vignette);"></div>

      <div class="container section-grid">
        <div class="reservation-copy">
          <p class="label-eyebrow reveal">{homeContent.reservation.eyebrow}</p>
          <h2 class="display reveal">
            {homeContent.reservation.heading[0]}<br />
            <span class="display-italic" style="color: var(--ember);">{homeContent.reservation.heading[1]}</span><br />
            {homeContent.reservation.heading[2]}
          </h2>
          <p class="reveal reveal-delay-1">{homeContent.reservation.body}</p>
          <div class="reservation-facts reveal reveal-delay-2">
            <div>
              <p class="label-eyebrow">Jam Operasional</p>
              <p>{siteConfig.hours.serviceDays}<br />{siteConfig.hours.seatings}</p>
            </div>
            <div>
              <p class="label-eyebrow">Hari Libur</p>
              <p>{siteConfig.hours.closed}</p>
            </div>
          </div>
        </div>

        <form class="reservation-form reveal" action={siteConfig.reservation.formAction} method={siteConfig.reservation.method} enctype="text/plain">
          <p class="label-eyebrow">{homeContent.reservation.formTitle}</p>
          <div class="form-grid">
            <div class="form-field--full">
              <label class="label-eyebrow" for="name">Nama lengkap <span aria-hidden="true">*</span></label>
              <input id="name" name="name" autocomplete="name" required />
            </div>
            <div>
              <label class="label-eyebrow" for="email">Email <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div>
              <label class="label-eyebrow" for="phone">No. HP</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
            <div>
              <label class="label-eyebrow" for="date">Tanggal <span aria-hidden="true">*</span></label>
              <input id="date" name="date" type="date" required />
            </div>
            <div>
              <label class="label-eyebrow" for="guests">Jumlah tamu</label>
              <select id="guests" name="guests">
                {["2", "3", "4", "5", "6"].map((option) => <option value={option}>{option}</option>)}
              </select>
            </div>
            <div class="form-field--full">
              <label class="label-eyebrow" for="note">Catatan tambahan</label>
              <textarea id="note" name="note" rows="3" placeholder="Alergi, permintaan khusus, atau hal lain yang perlu kami tahu."></textarea>
            </div>
          </div>
          <button class="form-button" type="submit">Kirim Reservasi <span aria-hidden="true">-&gt;</span></button>
          <p style="color: var(--muted-foreground); font-size: 0.85rem;">{homeContent.reservation.confirmation}</p>

          <div class="reservation-or-divider" aria-hidden="true">
            <span></span>
            <p>atau</p>
            <span></span>
          </div>

          <a
            class="button-link button-link--outline reservation-whatsapp-button"
            href={siteConfig.reservation.whatsapp}
            target="_blank"
            rel="noreferrer"
          >
            Reservasi via WhatsApp <span aria-hidden="true">-&gt;</span>
          </a>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>